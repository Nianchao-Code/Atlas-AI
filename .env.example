# Copy to .env and fill in. The API starts without a key, but
# retrieval-only / heuristic eval still work; generation needs a model.

OPENAI_API_KEY=
# Compatible gateways (Azure, DeepSeek, Ollama, vLLM) work via base URL.
OPENAI_BASE_URL=https://api.openai.com/v1

# Final answers. Use a stronger model here — this is what users read.
CHAT_MODEL=gpt-4o
# Rewrite, document grading, LLM-as-judge. Cheaper on purpose.
CHEAP_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=atlas_chunks

# Empty = Redis Streams (local). Set to enable Kafka-protocol brokers
# (Redpanda / MSK / Confluent). Same IndexJob schema either way.
KAFKA_BROKERS=
KAFKA_TOPIC=atlas.index.jobs

# Retrieval / cost knobs. These are the levers behind the resume numbers.
TOKEN_BUDGET=1800
RETRIEVE_K=24
RERANK_K=6
MAX_RETRIEVE_RETRIES=2
# Calibrated by scripts/calibrate_cache.py, not guessed: 0.82 catches 6 of 9
# measured paraphrases with no wrong hit, and clears the worst false pair
# (Seattle sick leave vs the China cap, 0.768) by five points.
SEMANTIC_CACHE_THRESHOLD=0.82

# Cross-encoder rerank after RRF. Off by default: the ablation measured it at
# zero benefit on this corpus, and it needs the optional [rerank] extra,
# which pulls in torch. See the README ablation table.
ENABLE_CROSS_ENCODER=false

# API auth. "principal:secret,principal:secret". Leave empty and auth is off:
# every caller becomes the "dev" principal, which is what quick start and CI
# use. /health reports which mode is live. scripts/k8s-deploy.ps1 generates a
# key for the Kubernetes deployment.
ATLAS_API_KEYS=
# Per-principal fixed window. 0 disables. Calibrated against measured
# throughput in scripts/loadtest.py rather than picked by feel.
RATE_LIMIT_PER_MINUTE=300
# Housekeeping tick: corpus gauges, and the paraphrase-cache sweep on a
# slower multiple of it. Retrieval does not wait on this -- dense and sparse
# both live in Qdrant and are current as soon as a write lands.
REFRESH_SECONDS=2.0
# How often to check that the catalogue and the vector store still agree. It
# scrolls the whole collection, so it is deliberately slow; 0 leaves this to
# startup and POST /api/v1/documents/reconcile.
RECONCILE_SECONDS=300
# USD per million tokens, {model: [input, output]}. Only used to turn measured
# token counts into a dollar figure; the tokens are reported either way. Check
# these against the current price list -- they are configuration, not fact.
MODEL_PRICES={"gpt-4o": [2.50, 10.00], "gpt-4o-mini": [0.15, 0.60], "text-embedding-3-small": [0.02, 0.0]}
# Port the worker exposes Prometheus metrics on. The API serves /metrics
# from its own app and ignores this. 0 disables.
METRICS_PORT=9100
# Browser origins allowed to call the API directly. In the container image the
# frontend is same-origin behind nginx, so this only needs the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Single-process demo: API also consumes the index queue.
EMBEDDED_WORKER=true
LOG_LEVEL=INFO
