# Copy to .env and fill in. The API starts without a key, but
# retrieval-only / heuristic eval still work; generation needs a model.

OPENAI_API_KEY=
# Compatible gateways (Azure, DeepSeek, Ollama, vLLM) work via base URL.
OPENAI_BASE_URL=https://api.openai.com/v1

# Final answers. Use a stronger model here — this is what users read.
CHAT_MODEL=gpt-4o
# Rewrite, document grading, LLM-as-judge. Cheaper on purpose.
CHEAP_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=atlas_chunks

# Empty = Redis Streams (local). Set to enable Kafka-protocol brokers
# (Redpanda / MSK / Confluent). Same IndexJob schema either way.
KAFKA_BROKERS=
KAFKA_TOPIC=atlas.index.jobs

# Retrieval / cost knobs. These are the levers behind the resume numbers.
TOKEN_BUDGET=1800
RETRIEVE_K=24
RERANK_K=6
MAX_RETRIEVE_RETRIES=2
SEMANTIC_CACHE_THRESHOLD=0.92

# Cross-encoder rerank after RRF (set false in CI / low-memory environments)
ENABLE_CROSS_ENCODER=true

# API auth. "principal:secret,principal:secret". Leave empty and auth is off:
# every caller becomes the "dev" principal, which is what quick start and CI
# use. /health reports which mode is live. scripts/k8s-deploy.ps1 generates a
# key for the Kubernetes deployment.
ATLAS_API_KEYS=
# Per-principal fixed window. 0 disables.
RATE_LIMIT_PER_MINUTE=60
# Browser origins allowed to call the API directly. In the container image the
# frontend is same-origin behind nginx, so this only needs the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Single-process demo: API also consumes the index queue.
EMBEDDED_WORKER=true
LOG_LEVEL=INFO
