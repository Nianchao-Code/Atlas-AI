server {
  listen 80;

  location /api/ {
    proxy_pass http://api:8000/api/;
    # The key is injected here, server side. A browser SPA cannot hold a
    # secret, so the browser never sees one: it calls a same-origin path and
    # nginx presents the credential. This authenticates the frontend to the
    # API; it is not user identity, and the Limits section says so.
    proxy_set_header X-API-Key "${ATLAS_API_KEY}";
    # 600s was sized for the eval endpoint, which used to hold the request
    # open for the whole golden set. That is a job now, so the longest thing
    # this proxies is a streamed answer: seconds, not minutes. Kept generous
    # rather than tight because SSE is idle between tokens, and a timeout that
    # fires mid-answer is a truncated answer, not an error anyone can see.
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_buffering off;
  }

  location /health {
    proxy_pass http://api:8000/health;
  }

  location / {
    root /usr/share/nginx/html;
    try_files $uri /index.html;
  }
}
